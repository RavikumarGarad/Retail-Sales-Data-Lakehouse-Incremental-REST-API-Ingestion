{
  "storage": {
    "landing_path": "abfss://landing@<storage-account>.dfs.core.windows.net/retail"
  },

  "apis": {
    "sales": {
      "name": "square_orders",
      "endpoint": "https://connect.squareup.com/v2/orders/search",
      "method": "POST",
      "incremental_column": "updated_at",
      "watermark_key": "sales",
      "page_size": 500,
      "sort_field": "UPDATED_AT",
      "sort_order": "ASC",
      "landing_folder": "sales"
    }
  },

  "incremental_load": {
    "initial_watermark": "2026-01-01T00:00:00Z",
    "watermark_format": "RFC3339"
  },

  "retry": {
    "max_retries": 3,
    "backoff_seconds": 5,
    "retry_status_codes": [
      429,
      500,
      502,
      503,
      504
    ]
  }
}